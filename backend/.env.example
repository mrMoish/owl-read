# Ключ OpenRouter (https://openrouter.ai/keys). Хранится ТОЛЬКО на backend.
OPENROUTER_API_KEY=
# Любая модель OpenRouter с поддержкой JSON-режима
OPENROUTER_MODEL=openai/gpt-4o-mini
# Часовой пояс "сегодня" на сервере (если клиент не прислал дату)
APP_TIMEZONE=America/Argentina/Buenos_Aires
DB_PATH=./data/app.sqlite3
ALLOWED_ORIGINS=
WOL_BASE_URL=https://wol.jw.org/ru/wol/h/r2/lp-u
WOL_ES_BASE_URL=https://wol.jw.org/es/wol/h/r4/lp-s
