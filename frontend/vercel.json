{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    { "source": "/en", "destination": "/en/", "permanent": true },
    { "source": "/es", "destination": "/es/", "permanent": true }
  ],
  "routes": [
    { "src": "/sw.js", "headers": { "cache-control": "no-cache" } },
    { "src": "/manifest-en.webmanifest", "dest": "/manifest-en.webmanifest" },
    { "src": "/manifest-es.webmanifest", "dest": "/manifest-es.webmanifest" },
    { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest" },
    { "handle": "filesystem" },
    { "src": "/en/(.*)", "dest": "/en/index.html" },
    { "src": "/en/", "dest": "/en/index.html" },
    { "src": "/es/(.*)", "dest": "/es/index.html" },
    { "src": "/es/", "dest": "/es/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
